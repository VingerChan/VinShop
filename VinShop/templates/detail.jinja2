<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/vite.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ sku.name }} - VinShop</title>
    <meta name="description" content="{{ sku.name }} - {{ sku.spu.desc }} - VinShop">
    <meta name="keywords" content="{{ sku.name }},{{ sku.spu.name }},VinShop">
    <link rel="stylesheet" href="/assets/index-DDL6kwf-.css">
    <script type="module" src="/assets/index-CjjfGkrP.js"></script>
    <script>window.__PRELOADED_SKU_DATA__ = {{ sku | tojson }};</script>
    <style>
        .image-carousel{width:100%}
        .image-main-wrapper{margin-bottom:12px;position:relative}
        .main-image{cursor:crosshair;border:1px solid #eee;border-radius:8px;flex-shrink:0;width:400px;height:400px;position:relative;overflow:hidden}
        .main-image img{object-fit:cover;pointer-events:none;width:100%;height:100%}
        .thumbnail-list{gap:8px;padding-bottom:4px;display:flex;overflow-x:auto}
        .thumbnail-item{cursor:pointer;border:2px solid transparent;border-radius:4px;flex-shrink:0;width:60px;height:60px;transition:border-color .2s;overflow:hidden}
        .thumbnail-item.active{border-color:#e4393c}
        .thumbnail-item img{object-fit:cover;width:100%;height:100%}
        .detail-page{padding:20px}
        .detail-top{background:#fff;border-radius:8px;gap:40px;margin-bottom:20px;padding:30px;display:flex}
        .detail-left{flex-shrink:0;width:400px}
        .detail-right{flex:1}
        .detail-title{font-size:22px;margin-bottom:12px;font-weight:700}
        .detail-desc{color:#999;margin-bottom:16px;font-size:14px}
        .detail-price-box{background:#fef0f0;border-radius:8px;margin-bottom:20px;padding:16px}
        .detail-price{color:#e4393c;font-size:28px;font-weight:700}
        .detail-stock{color:#666;margin:12px 0 20px;font-size:14px}
        .detail-actions{gap:16px;display:flex;align-items:center}
        .detail-actions.disabled{opacity:.5;pointer-events:none}
        .out-of-stock{color:#999;font-size:16px;font-weight:700}
        .spec-group{margin-bottom:16px}
        .spec-label{color:#999;margin-bottom:8px;font-size:14px}
        .spec-options{display:flex;flex-wrap:wrap;gap:10px}
        .spec-option{cursor:pointer;border:1px solid #ddd;border-radius:4px;padding:6px 16px;font-size:13px;color:#333;background:#fff;transition:all .2s}
        .detail-bottom{background:#fff;border-radius:8px;padding:20px}
        .detail-content{line-height:1.8}
        .btn-static{cursor:pointer;border:1px solid #ddd;border-radius:4px;padding:8px 20px;font-size:14px;color:#333;background:#fff}
        .btn-static:hover{color:#e4393c;border-color:#e4393c}
    </style>
</head>
<body>
    <div id="app">
        <header class="app-header">
            <div class="header-inner container">
                <a href="/" class="logo">VinShop</a>
                <div class="header-search">
                    <form action="/search" method="get" style="display:flex;gap:8px">
                        <input type="text" name="keyword" placeholder="搜索商品" style="flex:1;padding:6px 12px;border:1px solid #dcdfe6;border-radius:4px;outline:none">
                        <button type="submit" class="btn-static">搜索</button>
                    </form>
                </div>
                <nav class="header-nav">
                    <a href="/cart" class="nav-item">🛒 购物车</a>
                    <a href="/orders" class="nav-item">📦 我的订单</a>
                    <a href="/user" class="nav-item">👤 个人中心</a>
                </nav>
            </div>
        </header>

        <main class="main-content">
            <div class="detail-page container">
                <div class="detail-top">
                    <div class="detail-left">
                        <div class="image-carousel">
                            <div class="image-main-wrapper">
                                <div class="main-image">
                                    <img src="{{ sku.images[0] if sku.images else sku.default_image }}" alt="{{ sku.name }}">
                                </div>
                            </div>
                            {% if sku.images | length > 1 %}
                            <div class="thumbnail-list">
                                {% for img in sku.images %}
                                <div class="thumbnail-item{{ ' active' if loop.first }}">
                                    <img src="{{ img }}" alt="{{ sku.name }}">
                                </div>
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="detail-right">
                        <h1 class="detail-title">{{ sku.name }}</h1>
                        <p class="detail-desc">{{ sku.spu.desc }}</p>
                        <div class="detail-price-box">
                            <span class="detail-price">¥{{ sku.price }}</span>
                        </div>
                        {% for group in sku.specs %}
                        <div class="spec-group">
                            <p class="spec-label">{{ group.name }}</p>
                            <div class="spec-options">
                                {% for opt in group.options %}
                                <span class="spec-option">{{ opt.value }}</span>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                        <div class="detail-stock">
                            {% if sku.stock > 0 %}
 库存：{{ sku.stock }} 件
                            {% else %}
                            <span class="out-of-stock">暂时缺货</span>
                            {% endif %}
                        </div>
                        <div class="detail-actions{{ ' disabled' if sku.stock <= 0 }}">
                            <span class="detail-price">¥{{ sku.price }}</span>
                            <button type="button" class="btn-static">加入购物车</button>
                            <button type="button" class="btn-static">立即购买</button>
                        </div>
                    </div>
                </div>
                <div class="detail-bottom">
                    <div class="detail-content">{{ sku.spu.desc | safe }}</div>
                    <div style="padding:20px 0;color:#999;text-align:center">加载中...</div>
                </div>
            </div>
        </main>

        <footer class="app-footer">
            <p>© 2026 VinShop 版权所有</p>
        </footer>
    </div>
</body>
</html>